# Normalise text files to LF in the repository; Git checks them out with the
# platform's native endings. Keeps the CSS/JS diffs readable across machines.
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.py    text eol=lf

*.png   binary
*.jpg   binary
*.webp  binary
*.woff2 binary
